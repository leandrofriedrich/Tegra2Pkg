#include "Platform.h"

// DBG2 Definitions
#pragma pack (1)

typedef struct {
  EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT DeviceInfo;
  EFI_ACPI_2_0_GENERIC_ADDRESS_STRUCTURE BaseAddress;
  UINT32 AddressSize;
  CHAR8 NameSpaceString[sizeof("\\_SB.URTA")];
} DEBUG_DEVICE_INFO_UART;

typedef struct {
  EFI_ACPI_DEBUG_PORT_2_DESCRIPTION_TABLE Header;
  DEBUG_DEVICE_INFO_UART Uart;
} EFI_ACPI_DEBUG_PORT_2_TABLE;

#pragma pack ()

// Debug Port 2 table for UARTA (DSDT node URTA)
STATIC EFI_ACPI_DEBUG_PORT_2_TABLE Dbg2 =
{
  // Header
  {
    ACPI_HEADER (EFI_ACPI_DBG2_SIGNATURE, EFI_ACPI_DEBUG_PORT_2_TABLE,
                 EFI_ACPI_DEBUG_PORT_2_TABLE_REVISION),
    OFFSET_OF (EFI_ACPI_DEBUG_PORT_2_TABLE, Uart), // OffsetDbgDeviceInfo
    1                                              // NumberDbgDeviceInfo
  },
  // Uart
  {
    {
      EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT_REVISION, // Revision
      sizeof (DEBUG_DEVICE_INFO_UART),                        // Length
      1,                                                     // NumberofGenericAddressRegisters
      sizeof ("\\_SB.URTA"),                                  // NameSpaceStringLength
      OFFSET_OF (DEBUG_DEVICE_INFO_UART, NameSpaceString),    // NameSpaceStringOffset
      0,                                                     // OemDataLength
      0,                                                     // OemDataOffset
      DBG2_PORT_TYPE_SERIAL,                                  // PortType
      DBG2_SUBTYPE_NVIDIA,                                    // PortSubtype
      { 0, 0 },                                               // Reserved
      OFFSET_OF (DEBUG_DEVICE_INFO_UART, BaseAddress),        // BaseAddressRegisterOffset
      OFFSET_OF (DEBUG_DEVICE_INFO_UART, AddressSize)         // AddressSizeOffset
    },
    {
      EFI_ACPI_2_0_SYSTEM_MEMORY, // AddressSpaceId
      32,                         // RegisterBitWidth
      0,                          // RegisterBitOffset
      DBG2_GAS_ACCESS_DWORD,      // AccessSize
      UARTA_BASE                  // Address
    },
    UARTA_LENGTH,
    "\\_SB.URTA"
  }
};

//
// Reference the table being generated to prevent the optimizer from removing the
// data structure from the executable
//
VOID* CONST ReferenceAcpiTable = &Dbg2;
